LLM_PROVIDER=openai_compatible
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
APP_VERSION=0.4.0
APP_BRANCH=main
# The workflow administrator uses the existing login session to click Check updates.
# The bundled worker fetches the fixed public repository main through HTTPS.
UPDATE_ENABLED=true
# Normally leave this unset; Compose uses the absolute directory you launch from.
# Override when the Docker daemon sees the project at a different absolute path.
# APP_HOST_DIR=/absolute/path/to/amazon-ops-agent
# Optional administrator setup code. Leave blank to generate a private server-side code.
WORKFLOW_SETUP_TOKEN=
# Set true when serving through correctly configured HTTPS / trusted proxies.
WORKFLOW_COOKIE_SECURE=false

